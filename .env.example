# Copy this file to .env and fill in real values
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=knowledge_base
ANTHROPIC_API_KEY=sk-ant-<your-key>

# Optional: where the API server listens (npm start). The defaults are this computer
# only, port 3000; set HOST=0.0.0.0 to reach it from other machines (e.g. on a VM).
# HOST=127.0.0.1
# PORT=3000

# Optional: the Claude model that writes the answers, by its API model ID (hyphens,
# no dots). The default is claude-sonnet-5-5, which the prompt and the test runs were
# tuned on; other models are untested. The server prints the model in use when it
# starts.
# ANSWER_MODEL=claude-sonnet-5-5

# Optional: send LLM requests through a proxy or company gateway instead of the
# Anthropic API (https://api.anthropic.com, the default). ANTHROPIC_API_KEY is then the
# gateway's key. The gateway must be reachable from where the app runs (e.g. only on
# the company network or VPN). A variable already set in the environment wins over
# this file: check with node -e "console.log(process.env.ANTHROPIC_BASE_URL)".
# ANTHROPIC_BASE_URL=https://<gateway-host>/anthropic
